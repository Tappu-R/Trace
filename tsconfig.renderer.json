{
    "extends": "./tsconfig.base.json",

    "compilerOptions": {
        "target": "es2022",
        "module": "commonjs",
        "moduleResolution": "bundler",
        "lib": ["es2022", "DOM"],
        "jsx": "react-jsx",
        "types": ["vite/client"],
        "noEmitOnError": false,
        "rootDir": "./src/renderer",
        "outDir": "./dist/renderer"
    },
    "include": ["src/renderer/**/*", "src/@types/**/*.d.ts"],
    "exclude": ["node_modules"]
}