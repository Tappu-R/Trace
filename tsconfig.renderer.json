{
    "extends": "./tsconfig.base.json",

    "compilerOptions": {
        "target": "es2022",
        "module": "esnext",
        "moduleResolution": "bundler",
        "lib": ["es2022", "DOM"],
        "jsx": "react-jsx",
        "types": ["vite/client"],
        "paths": {
            "srcDir": ["./src/renderer"],
            "srcDir/*": ["./src/renderer/*"]
        },
        "noEmitOnError": false,
        "noEmit": true,
        "isolatedModules": true,
        "rootDir": "./src/renderer",
        "outDir": "./dist/renderer"
    },
    "include": ["src/renderer/**/*", "src/@types/**/*.d.ts"],
    "exclude": ["node_modules"]
}