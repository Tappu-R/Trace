{
    "extends": "./tsconfig.base.json",

    "compilerOptions": {
        "target": "es2025",
        "module": "commonjs",
        "lib": ["es2025", "DOM"],
    
        "noEmitOnError": false,
        
        "rootDir": "./src/renderer",
