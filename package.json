    "concurrently": "^10.0.4",
    "electron": "^42.0.0",
    "electron-window-state": "^5.0.3",
    "electron-window-state-manager": "^0.3.2",
    "excalidraw": "^0.6.4",
    "nodemon": "^3.1.14",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite": "^8.2.0"
  },
  "private": true,
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "latest",
    "typescript": "6.0.3"
  },
